---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import DoomPlayer from '~/components/widgets/DoomPlayer.astro';

const metadata = {
  title: 'Invader Zim Theme — A Site for DOOM',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <DoomPlayer />

  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Surrender Now',
        href: 'https://github.com/kwizzlesurp10-ctrl/astrowind',
        target: '_blank',
        icon: 'tabler:alien',
      },
    ]}
    image={{ src: '~/assets/images/hero_zim.png', alt: 'Invader Zim Hero Image' }}
  >
    <Fragment slot="title">
      Preparing Earth for <span class="hidden xl:inline">total and absolute</span>
      <span class="text-accent dark:text-white"> DOOM!</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Invader Zim Theme</span> shows you the amazing technology of the Irken Empire.
        Bow down before your new masters!</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">Doom is coming.</span>
      Suitable for Invaders, SIR Units, Almighty Tallest, and those who love Waffles, Tacos & Piggy!
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="Philosophy:" description="Simplicity, Best Practices and High Performance" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Superior Irken Technology"
    title="Why our invasion is inevitable"
    subtitle="Your resistance is futile. Observe the magnificence of our advanced civilization."
    items={[
      {
        title: 'Advanced Disguises',
        description:
          'Perfectly normal human child disguises. Definitely not alien invaders. Pay no attention to the green skin.',
        icon: 'tabler:mask',
      },
      {
        title: 'GIR Units',
        description:
          'Standard Information Retrieval Units. Sometimes they make waffles. Sometimes they scream.',
        icon: 'tabler:robot',
      },
      {
        title: 'Voot Cruisers',
        description:
          'The finest military vehicles in the galaxy. Capable of interstellar travel and grabbing snacks.',
        icon: 'tabler:rocket',
      },
      {
        title: 'The Massive',
        description:
          'Our command ship. It is very big. Consult the Tallest for more information.',
        icon: 'tabler:ship',
      },
      {
        title: 'Doom Song',
        description:
          "Doom doom doom doom doom doom doom... It's very catchy.",
        icon: 'tabler:music',
      },
      {
        title: 'Snacks',
        description:
          'We have discovered that Earth is rich in snacks. We shall consume them all.',
        icon: 'tabler:cookie',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="The Plan"
    title="Operation: Impending Doom"
    items={[
      {
        title: 'Phase 1: Infiltration',
        description:
          'Blend in with the indigenous population ("humans"). Attend their schools. Eat their "paste".',
      },
      {
        title: 'Phase 2: Preparation',
        description:
          'Construct a secret base. Fill it with giant tubes and blinking lights. Laugh maniacally.',
      },
      {
        title: 'Phase 3: DOOM',
        description:
          'Unleash the orbital lasers. Teleport the planet to the snack dimension. Victory!',
      },
    ]}
    image={{
      src: '~/assets/images/doom_machine.png',
      alt: 'Doom Machine Blueprint',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">The Mission</h3>
      Our mission is simple: Total planetary domination. And maybe finding some decent snacks along the way.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Superior Firepower',
        description: `Our lasers are much shinier than yours. And they make a cooler sound. Pew pew!`,
      },
      {
        title: 'Infinite Energy',
        description:
          'Powered by a micro-black hole and a hamster wheel. Mostly the hamster wheel.',
      },
      {
        title: 'Responsive Minions',
        description:
          "Our robots obey every command. Eventually. Unless they get distracted by a rubber piggy.",
      },
      {
        title: 'Multimedia Propaganda',
        description:
          'We will broadcast our victory across all channels. You cannot mute DOOM.',
      },
    ]}
    image={{
      src: '~/assets/images/hero_zim.png',
      alt: 'Irken Fleet',
    }}
  >
    <Fragment slot="content">Resistance is futile. Also, we have a giant robot.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Mandatory Fun',
        description:
          'All citizens must enjoy the designated fun activities. Smiling is enforced.',
      },
      {
        title: 'Continuous Monitoring',
        description:
          'We are watching you. Always. Nice shirt, by the way.',
      },
      {
        title: 'Efficiency',
        description:
          'We conquered the Vortians in a weekend. We are very efficient.',
      },
      {
        title: 'Community Support',
        description: `Join the Empire! We have dental. (Dental plan not guaranteed).`,
      },
    ]}
    image={{
      src: '~/assets/images/doom_machine.png',
      alt: 'Advanced Technology',
    }}
  >
    <Fragment slot="content">Join us, and you might get a taco.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="How to prepare for your new life."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Panic</span>',
        description:
          "Look up at the sky. See the giant armada? Run around in circles screaming. It is appropriate.",
        icon: 'tabler:package',
      },
      {
        title: 'Step 2: <span class="font-medium">Surrender</span>',
        description:
          "Throw down your weapons. Raise your hands. Offer snacks as tribute. Tacos are preferred.",
        icon: 'tabler:letter-case',
      },
      {
        title: 'Step 3: <span class="font-medium">Acceptance</span>',
        description:
          'Realize that your new Irken overlords are benevolent. Mostly. Just do not touch the red button.',
        icon: 'tabler:paint',
      },
      {
        title: 'Obey!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '~/assets/images/hero_zim.png',
      alt: 'Steps image',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Most used widgets"
    subtitle="Provides frequently used components for building websites using Tailwind CSS"
    tagline="Components"
    items={[
      {
        title: 'Headers',
        description: "Ever tried driving without GPS? Boom! That's why websites need headers for direction.",
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Heros',
        description:
          "Picture a superhero landing – epic, right? That's the job of a Hero section, making grand entrances!",
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'Features',
        description:
          'Where websites strut their stuff and show off superpowers. No holding back on the bragging rights here!',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'Content',
        description:
          "Dive into the meat and potatoes of a site; without it, you'd just be window shopping. Content is king.",
        icon: 'flat-color-icons:document',
      },
      {
        title: 'Call-to-Action',
        description:
          'That enthusiastic friend who\'s always urging, "Do it! Do it!"? Yeah, that\'s this button nudging you towards adventure.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'Pricing',
        description: 'Behold the dessert menu of the website world. Tempting choices await, can you resist?',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'Testimonial',
        description: 'Step into the gossip corner! Here, other visitors spill the beans and share the juicy details.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'Contact',
        description:
          'Like a digital mailbox, but faster! Drop a line, ask a question, or send a virtual high-five. Ding! Message in.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'Footers',
        description: "The footer's like the credits of a movie but sprinkled with easter eggs. Time to hunt!",
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`The blog is used to display AstroWind documentation.
                        Each new article will be an important step that you will need to know to be an expert in creating a website using Astro + Tailwind CSS.
                        Astro is a very interesting technology. Thanks.
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Dive into the following questions to gain insights into the powerful features that AstroWind offers and how it can elevate your web development journey."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Why AstroWind?',
        description:
          "Michael Knight a young loner on a crusade to champion the cause of the innocent. The helpless. The powerless in a world of criminals who operate above the law. Here he comes Here comes Speed Racer. He's a demon on wheels.",
      },
      {
        title: 'What do I need to start?',
        description:
          'Space, the final frontier. These are the voyages of the Starship Enterprise. Its five-year mission: to explore strange new worlds. Many say exploration is part of our destiny, but it’s actually our duty to future generations.',
      },
      {
        title: 'How to install the Astro + Tailwind CSS template?',
        description:
          "Well, the way they make shows is, they make one show. That show's called a pilot. Then they show that show to the people who make shows, and on the strength of that one show they decide if they're going to make more shows.",
      },
      {
        title: "What's something that you don't understand?",
        description:
          "A flower in my garden, a mystery in my panties. Heart attack never stopped old Big Bear. I didn't even know we were calling him Big Bear.",
      },
      {
        title: 'What is something that you would like to try again?',
        description:
          "A business big enough that it could be listed on the NASDAQ goes belly up. Disappears! It ceases to exist without me. No, you clearly don't know who you're talking to, so let me clue you in.",
      },
      {
        title: 'If you could only ask one question to each person you meet, what would that question be?',
        description:
          "This is not about revenge. This is about justice. A lot of things can change in twelve years, Admiral. Well, that's certainly good to know. About four years. I got tired of hearing how young I looked.",
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Downloads', amount: '132K' },
      { title: 'Stars', amount: '24.8K' },
      { title: 'Forks', amount: '10.3K' },
      { title: 'Users', amount: '48.4K' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Surrender Now',
        href: 'https://github.com/kwizzlesurp10-ctrl/astrowind',
        target: '_blank',
        icon: 'tabler:alien',
      },
    ]}
  >
    <Fragment slot="title">
      Join the&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Invasion</span>
    </Fragment>

    <Fragment slot="subtitle">
      Do not resist. <br class="hidden md:inline" />Doom is inevitable! :P
    </Fragment>
  </CallToAction>
</Layout>
