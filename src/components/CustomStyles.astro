---
import '@fontsource/space-grotesk';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// Librebaskerville
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Space Grotesk', sans-serif;
    --aw-font-serif: 'Space Grotesk', serif;
    --aw-font-heading: 'Space Grotesk', sans-serif;

    /* Invader Zim Palette */
    /* Primary: Neon Green (Zim) */
    --aw-color-primary: rgb(136 242 24);
    /* Secondary: Deep Purple (Space/Irken) */
    --aw-color-secondary: rgb(125 7 242);
    /* Accent: Magenta (GIR/Lasers) */
    --aw-color-accent: rgb(233 0 100);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(21 5 35);
  }

  .dark {
    --aw-font-sans: 'Space Grotesk', sans-serif;
    --aw-font-serif: 'Space Grotesk', serif;
    --aw-font-heading: 'Space Grotesk', sans-serif;

    --aw-color-primary: rgb(136 242 24);
    --aw-color-secondary: rgb(125 7 242);
    --aw-color-accent: rgb(233 0 100);

    --aw-color-text-heading: rgb(247 248 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    /* Deep space purple/black background */
    --aw-color-bg-page: rgb(21 5 35);
  }

  @keyframes twitch {
    0% { transform: translate(0, 0) rotate(0deg); }
    20% { transform: translate(-2px, 2px) rotate(-1deg); }
    40% { transform: translate(2px, -2px) rotate(1deg); }
    60% { transform: translate(-2px, -2px) rotate(0deg); }
    80% { transform: translate(2px, 2px) rotate(-1deg); }
    100% { transform: translate(0, 0) rotate(0deg); }
  }

  .btn-primary:hover {
    animation: twitch 0.3s infinite;
  }
</style>
