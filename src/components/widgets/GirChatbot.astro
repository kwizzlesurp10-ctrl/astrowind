---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
---

<div id="gir-chatbot" class="fixed bottom-4 right-4 z-50 flex flex-col items-end">
    <!-- Chat Window (Initially Hidden) -->
    <div id="chat-window" class="hidden mb-4 w-80 bg-page border-2 border-primary rounded-lg shadow-2xl overflow-hidden font-heading">
        <div class="bg-primary text-white p-3 flex justify-between items-center">
            <span class="font-bold text-lg">GIR</span>
            <button id="close-chat" class="text-white hover:text-red-500 focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div id="chat-messages" class="p-4 h-64 overflow-y-auto bg-gray-900 flex flex-col gap-2">
            <div class="self-start bg-gray-800 text-green-400 p-2 rounded-lg max-w-[80%] border border-green-500/30">
                HI! I'm GIR! Do you have any tacos?
            </div>
        </div>
        <div class="p-2 border-t border-gray-700 bg-page">
            <div class="flex gap-2">
                <input type="text" id="user-input" placeholder="Say something..." class="w-full p-2 rounded bg-gray-800 text-white border border-gray-600 focus:border-green-500 focus:outline-none" />
                <button id="send-btn" class="bg-green-600 hover:bg-green-500 text-white px-4 py-2 rounded font-bold transition-colors">
                    >
                </button>
            </div>
        </div>
    </div>

    <!-- Toggle Button (GIR's Head) -->
    <button id="gir-toggle" class="w-16 h-16 rounded-full border-4 border-green-500 overflow-hidden shadow-lg hover:scale-110 transition-transform bg-black group relative">
        <img src="https://api.iconify.design/game-icons:robot-antennas.svg?color=%2388cc00" alt="GIR" class="w-full h-full p-1 object-cover" />
        <div class="absolute inset-0 bg-green-500/20 group-hover:bg-transparent transition-colors"></div>
    </button>
</div>

<script>
    const toggleBtn = document.getElementById('gir-toggle');
    const chatWindow = document.getElementById('chat-window');
    const closeBtn = document.getElementById('close-chat');
    const sendBtn = document.getElementById('send-btn');
    const userInput = document.getElementById('user-input') as HTMLInputElement;
    const messagesContainer = document.getElementById('chat-messages');

    let isOpen = false;

    function toggleChat() {
        isOpen = !isOpen;
        if (isOpen) {
            chatWindow?.classList.remove('hidden');
        } else {
            chatWindow?.classList.add('hidden');
        }
    }

    async function sendMessage() {
        const text = userInput?.value.trim();
        if (!text) return;

        // Add user message
        appendMessage(text, 'user');
        if (userInput) userInput.value = '';

        // Show loading state (GIR screaming?)
        const loadingId = appendMessage('...', 'gir');

        try {
            const response = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text })
            });

            const data = await response.json();
            
            // Remove loading and show response
            const loadingMsg = document.getElementById(loadingId);
            loadingMsg?.remove();

            if (data.reply) {
                appendMessage(data.reply, 'gir');
            } else if (data.error) {
                appendMessage("I BROKE IT! " + data.error, 'gir');
            }
        } catch (e) {
            const loadingMsg = document.getElementById(loadingId);
            loadingMsg?.remove();
            appendMessage("MY HEAD HURTS! (Network Error)", 'gir');
        }
    }

    function appendMessage(text: string, sender: 'user' | 'gir') {
        const div = document.createElement('div');
        const id = 'msg-' + Date.now();
        div.id = id;
        div.className = sender === 'user' 
            ? 'self-end bg-purple-700 text-white p-2 rounded-lg max-w-[80%] border border-purple-500/30'
            : 'self-start bg-gray-800 text-green-400 p-2 rounded-lg max-w-[80%] border border-green-500/30';
        div.textContent = text;
        messagesContainer?.appendChild(div);
        messagesContainer?.scrollTo(0, messagesContainer.scrollHeight);
        return id;
    }

    toggleBtn?.addEventListener('click', toggleChat);
    closeBtn?.addEventListener('click', toggleChat);
    sendBtn?.addEventListener('click', sendMessage);
    userInput?.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
    });
</script>
